<!DOCTYPE html>
<html lang="<%= current_language %>">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= @title.presence || (@project ? "#{l(:label_redmine_quick_timelog_timer)} — #{@project.name}" : l(:label_redmine_quick_timelog_timer)) %></title>
  <%= csrf_meta_tags %>
  <%= stylesheet_link_tag 'redmine_quick_timelog.css', :plugin => 'redmine_quick_timelog' %>
  <%= javascript_include_tag 'redmine_quick_timelog_parser.js', :plugin => 'redmine_quick_timelog' %>
  <%= javascript_include_tag 'redmine_quick_timelog_timer.js', :plugin => 'redmine_quick_timelog' %>
  <script type="application/json" id="redmine-quick-timelog-config"><%= raw ERB::Util.json_escape(redmine_quick_timelog_config(@project).to_json) %></script>
</head>
<body class="qtl-popup-body">
  <%= yield %>
</body>
</html>
